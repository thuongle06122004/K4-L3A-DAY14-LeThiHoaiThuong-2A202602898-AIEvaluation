# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder values.
# With no OPENAI_BASE_URL, the official OpenAI API endpoint is used.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-openai-compatible-provider/v1
